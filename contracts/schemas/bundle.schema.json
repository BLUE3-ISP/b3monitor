{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b3mon.example/contracts/schemas/bundle.schema.json",
  "title": "Configuração enviada à sonda",
  "description": "Corpo de GET /api/v1/probe/config (06 §4). `bundle_revision` versiona o conjunto; `config_generation` versiona cada assignment, e um assignment inalterado mantém a geração. O bundle NUNCA traz política local de redes: só seleciona operações já autorizadas na VM (INV-09). Segredos entram por REFERÊNCIA (`credential_ref`), nunca em texto. Nenhum campo aceita URL de callback ou instrução executável (06 §11): `additionalProperties` é falso em todo nível.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "bundle_revision", "issued_at", "expires_at", "assignments"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "probe_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "bundle_revision": { "type": "integer", "minimum": 1 },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp_utc" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp_utc" },
    "assignments": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/assignment" }
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id", "config_generation", "check_id", "kind", "ip_family", "target", "schedule",
        "policy_revision", "path_profile_id", "credential_ref"
      ],
      "properties": {
        "assignment_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "config_generation": { "type": "integer", "minimum": 1 },
        "check_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "kind": { "$ref": "common.schema.json#/$defs/check_kind" },
        "ip_family": { "$ref": "common.schema.json#/$defs/ip_family" },
        "target": { "type": "object" },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "interval_s", "jitter_offset_ms", "start_tolerance_ms", "timeout_ms"],
          "properties": {
            "epoch": { "$ref": "common.schema.json#/$defs/timestamp_utc" },
            "interval_s": { "type": "integer", "minimum": 1 },
            "jitter_offset_ms": { "$ref": "common.schema.json#/$defs/non_negative_int" },
            "start_tolerance_ms": { "$ref": "common.schema.json#/$defs/non_negative_int" },
            "timeout_ms": { "type": "integer", "minimum": 1 }
          }
        },
        "policy_revision": { "$ref": "common.schema.json#/$defs/short_text" },
        "path_profile_id": { "$ref": "common.schema.json#/$defs/uuid_or_null" },
        "credential_ref": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/short_text" }] }
      },
      "allOf": [
        {
          "description": "Nesta fatia (F0-01) só o alvo HTTP é detalhado. tcp, icmp, dns e tls ganham o `target` próprio em F0-03; até lá aceitam um objeto livre e o servidor os recusa se a sonda não os anunciar.",
          "if": { "properties": { "kind": { "const": "http" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "method", "allowed_status_codes", "follow_redirects"],
                "properties": {
                  "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
                  "method": { "enum": ["GET", "HEAD"] },
                  "allowed_status_codes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 100, "maximum": 599 }
                  },
                  "follow_redirects": { "type": "boolean" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
